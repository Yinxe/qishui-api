{
  "name": "qishui-tui",
  "version": "0.0.1",
  "description": "汽水音乐终端 TUI（ink：侧边栏导航 + 通用列表 + 播放条 + 歌词/评论覆盖层，依赖 qishui-core）",
  "type": "module",
  "bin": {
    "qishui-tui": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@ink-tools/ink-mouse": "^2.1.0",
    "ink": "^7.0.0",
    "qishui-core": "workspace:*",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.0.0",
    "typescript": "^7.0.2"
  }
}
