{
  "name": "qishui-core",
  "version": "0.2.0",
  "description": "汽水音乐应用后端核心：qishui-api 之上的 OOP 封装（账号/曲库/歌单/发现/搜索/评论/社交 + 播放器状态机 + 本地数据与媒体缓存）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types test/smoke.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "qishui-api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
